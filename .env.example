# Microsoft Fabric Eventstream / Azure Event Hubs Connection String (Optional: falls back to local JSONL if unset)
EVENTHUB_CONNECTION_STRING="Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<key_name>;SharedAccessKey=<key>;EntityPath=<eventhub_name>"

# Local Edge LLM Configuration (Ollama OpenAI-compatible endpoint)
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.2"          # Options: "llama3.2" or "phi4-mini"

# Broadcast Engine Replay & Personalization Settings
MATCH_SPEED="60"                 # Base replay speed (match seconds per real second)
TACTICAL_SPEED="2.0"             # Dynamic slowdown speed during active LLM inference
DYNAMIC_PACING="1"               # 1 = enable automatic tactical slowdown, 0 = disable
LLM_TIMEOUT="45"                 # Max seconds allowed per episode generation
BROADCAST_LANG="English"         # Options: "English" or "French"
BROADCAST_PERSONA="General Fan"  # Options: "General Fan", "Tactical Analyst", "Club Ultra"
